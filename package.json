{
  "name": "p2p-redirect",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode=production",
    "build:dev": "webpack --config webpack.config.js --mode=development",
    "watch": "webpack --config webpack.config.js --mode=development --watch",
    "start": "http-server ./public -p 8080 --cors",
    "start:second": "http-server ./public -p 8081 --cors",
    "start:bootstrap": "node bootstrap-node.js",
    "start:bootstrap:prod": "node bootstrap-node-prod.js",
    "dev": "start /B npm run watch && npm run start",
    "clean": "del /Q public\\* .webpack_cache\\*"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.1",
    "@chainsafe/libp2p-noise": "^16.1.2",
    "@libp2p/bootstrap": "^11.0.35",
    "@libp2p/circuit-relay-v2": "^3.2.11",
    "@libp2p/identify": "^3.0.29",
    "@libp2p/kad-dht": "^15.0.2",
    "@libp2p/logger": "^5.1.15",
    "@libp2p/mdns": "^11.0.35",
    "@libp2p/mplex": "^11.0.35",
    "@libp2p/ping": "^2.0.29",
    "@libp2p/tcp": "^10.1.10",
    "@libp2p/webrtc": "^5.0.4",
    "@libp2p/websockets": "^9.2.10",
    "@multiformats/multiaddr": "^12.0.0",
    "cors": "^2.8.5",
    "crypto-browserify": "^3.12.1",
    "express": "^5.1.0",
    "fast-text-encoding": "^1.0.6",
    "libp2p": "^2.8.5",
    "node-cache": "^5.1.2",
    "uint8arrays": "^5.0.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "assert": "^2.1.0",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^13.0.0",
    "core-js": "^3.38.1",
    "http-server": "^14.1.1",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.97.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4"
  }
}